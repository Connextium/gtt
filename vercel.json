{
  "version": 2,
  "buildCommand": "npm run api:build",
  "installCommand": "npm install",
  "functions": {
    "apps/api/api/index.mjs": {
      "runtime": "nodejs20.x",
      "includeFiles": "**/*"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/api/api/index.mjs"
    }
  ]
}
